# Local-only development settings. Copy this file to .env and adjust only local asset paths.
# The application enforces loopback binding and a hard-coded pre-IoT lockdown.

ISL_HOST=127.0.0.1
ISL_PORT=8000
ISL_DB_PATH=var/isl_events.sqlite3

# Manual single-sign capture contract (locked maximum: 169 frames / 6 seconds).
ISL_MIN_CAPTURE_FRAMES=12
ISL_MAX_CAPTURE_SECONDS=6.0
ISL_MIN_POSE_RATIO=0.50
ISL_MIN_HAND_RATIO=0.30
ISL_MAX_EXTRACTION_FAILURE_RATIO=0.30
ISL_MAX_FRAME_BYTES=1500000
# Compatibility only; the current manual capture path buffers JPEG frames and does not use a frame queue.
ISL_FRAME_QUEUE_SIZE=8

# External assets are not distributed in the source ZIP. Set these to your verified local paths.
AI4BHARAT_REPO=
ISL_CHECKPOINT=
ISL_LABEL_MAP=config/label_map_include50.json
ISL_REFERENCE_VIDEO_DIR=data/include_videos
ISL_REFERENCE_METADATA=data/include50_video_metadata.json

# Text confidence is provisional and uncalibrated. Keep 0.40 unchanged during pipeline diagnostics.
ISL_CONFIDENCE_THRESHOLD=0.40

# IoT remains OFF. This environment variable cannot override the application-level hard lock.
ISL_IOT_ENABLED=false
ISL_IOT_COOLDOWN_SECONDS=5
ISL_IOT_LABEL_MAP=config/iot_label_map.json
ISL_IOT_MIN_CONFIDENCE=0.70
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_COMMAND_TOPIC=isl/command/v1
MQTT_ACK_TOPIC=isl/ack/v1
MQTT_ACK_TIMEOUT_SECONDS=5
